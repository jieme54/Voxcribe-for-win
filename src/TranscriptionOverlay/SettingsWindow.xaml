<Window x:Class="TranscriptionOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Voxcribe Settings"
        Width="660"
        Height="500"
        MinWidth="660"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF9F2E8"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#19140F" />
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFF8F4EE" />
            <Setter Property="Background" Value="#1C3C31" />
            <Setter Property="BorderBrush" Value="#1C3C31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource FooterButtonStyle}">
            <Setter Property="Foreground" Value="#251F17" />
            <Setter Property="Background" Value="#F7EAD3" />
            <Setter Property="BorderBrush" Value="#251F17" />
        </Style>

        <Style x:Key="RuntimeInstallButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryDialogButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#F7EAD3" />
            <Setter Property="BorderBrush" Value="#251F17" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3DFC0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelSelectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeToggleButtonStyle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#5A4A39" />
            <Setter Property="Background" Value="#FFFDF9F3" />
            <Setter Property="BorderBrush" Value="#D4C1A3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFF8F4EE" />
                    <Setter Property="Background" Value="#1C3C31" />
                    <Setter Property="BorderBrush" Value="#1C3C31" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3DFC0" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#22493B" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ModelBrowserItemTemplate">
            <Border Margin="0,0,0,10"
                    Padding="10"
                    Background="{Binding CardBackground}"
                    BorderBrush="{Binding CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="34"
                            Height="34"
                            Background="#F7EAD3"
                            BorderBrush="#251F17"
                            BorderThickness="1"
                            CornerRadius="12"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.BetweenShowDelay="0"
                            ToolTipService.Placement="Relative"
                            ToolTipService.HorizontalOffset="17"
                            ToolTipService.VerticalOffset="17"
                            ToolTipService.ShowDuration="60000"
                            ToolTip="{Binding InfoText}"
                            Visibility="{Binding InfoVisibility}">
                        <Border Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="#251F17"
                                BorderThickness="1"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#251F17"
                                       Text="i" />
                        </Border>
                    </Border>

                    <Button Grid.Column="1"
                            Tag="{Binding ActionTag}"
                            Style="{StaticResource ModelSelectButtonStyle}"
                            Click="SelectModelButton_Click"
                            IsEnabled="{Binding CanSelect}">
                        <StackPanel Margin="12,0,10,0">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#19140F"
                                       TextWrapping="Wrap"
                                       Text="{Binding DisplayName}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#7A5A2B"
                                       TextWrapping="Wrap"
                                       Text="{Binding SourceText}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#6B5A47"
                                       TextWrapping="Wrap"
                                       Text="{Binding StatusText}" />
                            <WrapPanel Margin="0,8,0,0"
                                       Visibility="{Binding CountBadgesVisibility}">
                                <Border Margin="0,0,8,0"
                                        Padding="8,4"
                                        Background="#E8F0E8"
                                        BorderBrush="#66856F"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding ModelCountVisibility}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#31543B"
                                               Text="{Binding ModelCountText}" />
                                </Border>
                                <Border Padding="8,4"
                                        Background="#F2E7F4"
                                        BorderBrush="#8D6B93"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding VariantCountVisibility}">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#67456D"
                                               Text="{Binding VariantCountText}" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="2"
                            Width="58"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding FileBadgeBackground}"
                            BorderBrush="{Binding FileBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Opacity="{Binding FileBadgeOpacity}"
                            ToolTip="{Binding FileBadgeToolTip}"
                            Visibility="{Binding CapabilityBadgesVisibility}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{Binding FileBadgeForeground}"
                                   Text="{Binding FileBadgeText}" />
                    </Border>

                    <Border Grid.Column="4"
                            Width="48"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{Binding RealtimeBadgeBackground}"
                            BorderBrush="{Binding RealtimeBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Opacity="{Binding RealtimeBadgeOpacity}"
                            ToolTip="{Binding RealtimeBadgeToolTip}"
                            Visibility="{Binding CapabilityBadgesVisibility}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{Binding RealtimeBadgeForeground}"
                                   Text="{Binding RealtimeBadgeText}" />
                    </Border>

                    <Button Grid.Column="5"
                            Tag="{Binding ActionTag}"
                            Style="{StaticResource IconButtonStyle}"
                            Click="ManageModelButton_Click"
                            ToolTip="{Binding ManageToolTip}"
                            IsEnabled="{Binding CanManage}"
                            Visibility="{Binding ManageVisibility}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#251F17"
                                   Text="{Binding ManageGlyph}" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid"
          Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SettingsTitleTextBlock"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#19140F"
                       Text="Voxcribe Settings" />

            <Button x:Name="OpenAppDataFolderButton"
                    Grid.Column="1"
                    Height="34"
                    MinWidth="0"
                    Padding="10,5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="OpenAppDataFolderButton_Click"
                    Style="{StaticResource RuntimeInstallButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE8B7;" />
                    <TextBlock x:Name="OpenAppDataFolderButtonTextBlock"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Text="Voxcribe folder" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid x:Name="SettingsHomeView">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                        <TextBlock x:Name="LanguageSectionTitleTextBlock"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="Interface language" />
                        <ComboBox x:Name="LanguageComboBox"
                                  Margin="0,10,0,0"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem x:Name="FrenchLanguageComboBoxItem"
                                          Tag="fr"
                                          Content="French" />
                            <ComboBoxItem x:Name="EnglishLanguageComboBoxItem"
                                          Tag="en"
                                          Content="English" />
                        </ComboBox>

                        <TextBlock x:Name="AudioSourceSectionTitleTextBlock"
                                   Margin="0,18,0,0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="Audio source" />
                        <ComboBox x:Name="AudioSourceComboBox"
                                  Margin="0,10,0,0"
                                  SelectionChanged="AudioSourceComboBox_SelectionChanged"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id" />

                        <TextBlock x:Name="HotkeySectionTitleTextBlock"
                                   Margin="0,18,0,0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="Keyboard shortcut" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="HotkeyTextBox"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center"
                                     Background="#FFFDF9F3"
                                     BorderBrush="#D4C1A3"
                                     BorderThickness="1"
                                     Text="Ctrl+Alt+Shift+V" />

                            <Button x:Name="CaptureHotkeyButton"
                                    Grid.Column="2"
                                    Click="CaptureHotkeyButton_Click"
                                    Style="{StaticResource FooterButtonStyle}"
                                    Height="34"
                                    MinWidth="0"
                                    Padding="12,6"
                                    Content="Change" />
                        </Grid>

                        <TextBlock x:Name="TranscriptOutputSectionTitleTextBlock"
                                   Margin="0,18,0,0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="Transcript window" />

                        <CheckBox x:Name="TranscriptWindowCheckBox"
                                  Margin="0,10,0,0"
                                  Checked="TranscriptWindowCheckBox_Changed"
                                  Unchecked="TranscriptWindowCheckBox_Changed">
                            <TextBlock x:Name="TranscriptWindowCheckBoxTextBlock"
                                       Width="204"
                                       TextWrapping="Wrap"
                                       Text="Open a separate window for each transcription" />
                        </CheckBox>

                        <CheckBox x:Name="AutoOpenTranscriptWindowCheckBox"
                                  Margin="0,8,0,0"
                                  Checked="AutoOpenTranscriptWindowCheckBox_Changed"
                                  Unchecked="AutoOpenTranscriptWindowCheckBox_Changed">
                            <TextBlock x:Name="AutoOpenTranscriptWindowCheckBoxTextBlock"
                                       Width="204"
                                       TextWrapping="Wrap"
                                       Text="Open the transcript window automatically" />
                        </CheckBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="CurrentModelSectionTitleTextBlock"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="Current model" />
                    <Border Margin="0,10,0,0"
                            Padding="12,10"
                            Background="#F7EAD3"
                            BorderBrush="#D1B78F"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentModelValueTextBlock"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#251F17"
                                       Text="Voxtral Mini 3B" />
                            <TextBlock x:Name="CurrentModelSourceTextBlock"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#6B5A47"
                                       Text="Voxcribe copy" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ChooseModelButton"
                                Click="ChooseModelButton_Click"
                                Style="{StaticResource FooterButtonStyle}"
                                HorizontalAlignment="Left"
                                Content="Choose model" />

                        <Border Grid.Column="2"
                                Padding="4"
                                Background="#FFFDF9F3"
                                BorderBrush="#D4C1A3"
                                BorderThickness="1"
                                CornerRadius="13">
                            <StackPanel Orientation="Horizontal">
                                <primitives:ToggleButton x:Name="TraditionalModeToggleButton"
                                                         Margin="0,0,4,0"
                                                         Click="TraditionalModeToggleButton_Click"
                                                         Style="{StaticResource ModeToggleButtonStyle}"
                                                         Content="Standard" />
                                <primitives:ToggleButton x:Name="RealtimeModeToggleButton"
                                                         Click="RealtimeModeToggleButton_Click"
                                                         Style="{StaticResource ModeToggleButtonStyle}"
                                                         Content="Real-time" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <CheckBox x:Name="RealtimeTranscriptWindowCheckBox"
                              Margin="0,10,0,0"
                              Visibility="Collapsed"
                              Checked="RealtimeTranscriptWindowCheckBox_Changed"
                              Unchecked="RealtimeTranscriptWindowCheckBox_Changed">
                        <TextBlock x:Name="RealtimeTranscriptWindowCheckBoxTextBlock"
                                   Width="270"
                                   TextWrapping="Wrap"
                                   Text="Afficher le texte en direct dans la fenêtre de transcription" />
                    </CheckBox>
                    <TextBlock x:Name="HardwareAccelerationSectionTitleTextBlock"
                               Margin="0,20,0,0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="Hardware acceleration" />
                    <Border Margin="0,10,0,0"
                            Padding="12,10"
                            Background="#FFFDF9F3"
                            BorderBrush="#D4C1A3"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <ComboBox x:Name="HardwareAccelerationComboBox"
                                      SelectionChanged="HardwareAccelerationComboBox_SelectionChanged"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding CanSelect}" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="InstallNvidiaRuntimeButton"
                                        Margin="0,0,4,0"
                                        Height="34"
                                        Click="InstallNvidiaRuntimeButton_Click"
                                        Style="{StaticResource RuntimeInstallButtonStyle}"
                                        Content="Install NVIDIA" />

                                <Button x:Name="InstallAmdRuntimeButton"
                                        Grid.Column="1"
                                        Margin="4,0,4,0"
                                        Height="34"
                                        Click="InstallAmdRuntimeButton_Click"
                                        Style="{StaticResource RuntimeInstallButtonStyle}"
                                        Content="Install AMD runtime" />

                                <Button x:Name="InstallCpuRuntimeButton"
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Height="34"
                                        Click="InstallCpuRuntimeButton_Click"
                                        Style="{StaticResource RuntimeInstallButtonStyle}"
                                        Content="Install CPU runtime" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <TextBlock x:Name="GpuDiagnosticTextBlock"
                                           FontSize="12"
                                           Foreground="#6B5A47"
                                           TextWrapping="Wrap"
                                           Text="Checking GPU..." />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="SettingsStatusTextBlock"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="#6B5A47"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ModelBrowserView"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BackToSettingsButton"
                            Click="BackToSettingsButton_Click"
                            Style="{StaticResource IconButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#251F17"
                                   Text="&#xE72B;" />
                    </Button>

                    <TextBlock x:Name="ModelsSectionTitleTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="Available models" />

                    <Button x:Name="AddLocalModelButton"
                            Grid.Column="3"
                            Width="34"
                            Height="34"
                            Click="AddLocalModelButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Add local model">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#251F17"
                                   Text="&#xE838;" />
                    </Button>
                </Grid>

                <Border x:Name="ModelBrowserListBorder"
                        Grid.Row="1"
                        Margin="0,14,0,6"
                        Padding="8"
                        Height="474"
                        VerticalAlignment="Top"
                        Background="#FFFDF9F3"
                        BorderBrush="#D4C1A3"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Grid x:Name="ModelBrowserViewport"
                          ClipToBounds="True">
                        <Grid x:Name="ModelBrowserPaneA">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ModelBrowserPaneABackButton"
                                        Width="30"
                                        Height="30"
                                        Click="ModelBrowserLevelBackButton_Click"
                                        Style="{StaticResource IconButtonStyle}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="#251F17"
                                               Text="&#xE72B;" />
                                </Button>
                                <TextBlock x:Name="ModelBrowserPaneATitleTextBlock"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ModelsItemsControlA"
                                              ItemTemplate="{StaticResource ModelBrowserItemTemplate}" />
                            </ScrollViewer>
                        </Grid>

                        <Grid x:Name="ModelBrowserPaneB"
                              Visibility="Collapsed">
                            <Grid.RenderTransform>
                                <TranslateTransform />
                            </Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="4,0,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ModelBrowserPaneBBackButton"
                                        Width="30"
                                        Height="30"
                                        Click="ModelBrowserLevelBackButton_Click"
                                        Style="{StaticResource IconButtonStyle}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="#251F17"
                                               Text="&#xE72B;" />
                                </Button>
                                <TextBlock x:Name="ModelBrowserPaneBTitleTextBlock"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SectionTitleStyle}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ModelsItemsControlB"
                                              ItemTemplate="{StaticResource ModelBrowserItemTemplate}" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="ConfirmationOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="20"
                Background="#8AFFF9F2"
                Visibility="Collapsed">
            <Grid>
                <Border Width="360"
                        MaxWidth="360"
                        Padding="18"
                        Background="#FFF9F2E8"
                        BorderBrush="#231C16"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="ConfirmationTitleTextBlock"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#19140F"
                                   Text="Confirmation" />

                        <TextBlock x:Name="ConfirmationMessageTextBlock"
                                   Grid.Row="1"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#2F261D"
                                   TextWrapping="Wrap"
                                   Text="Confirmer cette action ?" />

                        <StackPanel Grid.Row="2"
                                    Margin="0,18,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="ConfirmationCancelButton"
                                    MinWidth="92"
                                    Margin="0,0,8,0"
                                    Click="ConfirmationCancelButton_Click"
                                    Style="{StaticResource SecondaryDialogButtonStyle}"
                                    Content="Non" />

                            <Button x:Name="ConfirmationConfirmButton"
                                    MinWidth="92"
                                    Click="ConfirmationConfirmButton_Click"
                                    Style="{StaticResource FooterButtonStyle}"
                                    Content="Oui" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
