<Window x:Class="TranscriptionOverlay.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Derni&#xE8;re transcription"
        Width="720"
        Height="520"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#FFF9F2E8"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFF8F4EE" />
            <Setter Property="Background" Value="#1C3C31" />
            <Setter Property="BorderBrush" Value="#1C3C31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditHistoryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#251F17" />
            <Setter Property="Background" Value="#F7EAD3" />
            <Setter Property="BorderBrush" Value="#251F17" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="WindowTitleTextBlock"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#19140F"
                       Text="Derni&#xE8;re transcription" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button x:Name="UndoButton"
                        Margin="0,0,8,0"
                        Click="UndoButton_Click"
                        Style="{StaticResource EditHistoryButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE7A7;" />
                </Button>

                <Button x:Name="RedoButton"
                        Margin="0,0,8,0"
                        Click="RedoButton_Click"
                        Style="{StaticResource EditHistoryButtonStyle}">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Text="&#xE7A6;" />
                </Button>

                <Button x:Name="CopyButton"
                        Click="CopyButton_Click"
                        Style="{StaticResource CopyButtonStyle}"
                        Content="Copier" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="TranscriptTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,0"
                 Padding="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 IsReadOnly="False"
                 IsUndoEnabled="True"
                 UndoLimit="100"
                 TextChanged="TranscriptTextBox_TextChanged"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontSize="14"
                 Background="#FFFDF9F3"
                 BorderBrush="#D4C1A3"
                 BorderThickness="1"
                 Text="" />
    </Grid>
</Window>
