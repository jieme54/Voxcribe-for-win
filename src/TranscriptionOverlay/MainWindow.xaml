<Window x:Class="TranscriptionOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Voxcribe"
        Icon="Assets/voxtral_icon.ico"
        Width="452"
        Height="184"
        MinWidth="224"
        MinHeight="96"
        MaxWidth="452"
        MaxHeight="184"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="Bahnschrift"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <LinearGradientBrush x:Key="OverlayBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF6E8" Offset="0" />
            <GradientStop Color="#F0E6D4" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF7F2E7" />
            <Setter Property="Background" Value="#1C3C31" />
            <Setter Property="BorderBrush" Value="#1C3C31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="#251F17" />
            <Setter Property="Background" Value="#F7EAD3" />
            <Setter Property="BorderBrush" Value="#251F17" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="#251F17" />
            <Setter Property="Background" Value="#F7EAD3" />
            <Setter Property="BorderBrush" Value="#251F17" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguagePickerButtonStyle" TargetType="{x:Type primitives:ToggleButton}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="34" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="#251F17" />
            <Setter Property="Background" Value="#F7EAD3" />
            <Setter Property="BorderBrush" Value="#251F17" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:ToggleButton}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3DFC0" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F3DFC0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.68" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LanguageOptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,4,4,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EED7B1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E6D5BC" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="{x:Type primitives:Thumb}">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="-6" />
            <Setter Property="Background" Value="#02000000" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Panel.ZIndex" Value="50" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource OverlayBrush}"
            BorderBrush="#211B15"
            BorderThickness="1"
            CornerRadius="9"
            Padding="10,4,10,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Row="0"
                           VerticalAlignment="Top"
                           Margin="0,2,0,0"
                           Text="Voxcribe"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#19140F" />

                <Border x:Name="TitleLogoBorder"
                        Grid.Row="0"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,5,0,0"
                        CornerRadius="8"
                        Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/voxtral_icon.ico"
                                    Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Click="SettingsButton_Click"
                        Style="{StaticResource ChromeButtonStyle}"
                        ToolTip="Param&#xE8;tres">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="#251F17"
                               Text="&#xE713;" />
                </Button>

                <Button x:Name="TranscriptButton"
                        Grid.Column="3"
                        Click="TranscriptButton_Click"
                        Style="{StaticResource ChromeButtonStyle}"
                        ToolTip="Afficher la derni&#xE8;re transcription">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="#251F17"
                               Text="&#xE8A5;" />
                </Button>

                <Button x:Name="ImportMediaButton"
                        Grid.Column="5"
                        Click="ImportMediaButton_Click"
                        Style="{StaticResource ChromeButtonStyle}"
                        ToolTip="Importer un fichier audio ou vid&#xE9;o">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="#251F17"
                               Text="&#xE8E5;" />
                </Button>

                <primitives:ToggleButton x:Name="LanguagePickerButton"
                        Grid.Column="7"
                        Style="{StaticResource LanguagePickerButtonStyle}"
                        PreviewMouseLeftButtonDown="LanguagePickerButton_PreviewMouseLeftButtonDown"
                        Click="LanguagePickerButton_Click"
                        ToolTip="Langue de l'interface">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0"
                              HorizontalAlignment="Right"
                              Margin="0,0,5,0">
                            <Viewbox x:Name="SelectedFrenchFlag"
                                     Width="24"
                                     Height="16"
                                     Stretch="Fill"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center">
                                <Border Width="30" Height="20" BorderThickness="1" BorderBrush="#251F17" CornerRadius="2">
                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="0" Fill="#0055A4" />
                                        <Rectangle Grid.Column="1" Fill="#FFFFFF" />
                                        <Rectangle Grid.Column="2" Fill="#EF4135" />
                                    </Grid>
                                </Border>
                            </Viewbox>

                            <Viewbox x:Name="SelectedEnglishFlag"
                                     Width="24"
                                     Height="16"
                                     Stretch="Fill"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed">
                                <Border Width="30" Height="20" BorderThickness="1" BorderBrush="#251F17" CornerRadius="2" Background="#012169">
                                    <Grid ClipToBounds="True">
                                        <Line X1="0" Y1="0" X2="30" Y2="20" Stroke="#FFFFFF" StrokeThickness="5" />
                                        <Line X1="30" Y1="0" X2="0" Y2="20" Stroke="#FFFFFF" StrokeThickness="5" />
                                        <Line X1="0" Y1="0" X2="30" Y2="20" Stroke="#C8102E" StrokeThickness="2.4" />
                                        <Line X1="30" Y1="0" X2="0" Y2="20" Stroke="#C8102E" StrokeThickness="2.4" />
                                        <Rectangle Width="30" Height="8" Fill="#FFFFFF" VerticalAlignment="Center" />
                                        <Rectangle Width="8" Height="20" Fill="#FFFFFF" HorizontalAlignment="Center" />
                                        <Rectangle Width="30" Height="4" Fill="#C8102E" VerticalAlignment="Center" />
                                        <Rectangle Width="4" Height="20" Fill="#C8102E" HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </Grid>

                        <Path Grid.Column="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 0 L 4 4 L 8 0"
                              Stroke="#251F17"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </primitives:ToggleButton>

                <Popup x:Name="LanguagePickerPopup"
                       Grid.Column="7"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=LanguagePickerButton}"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       Closed="LanguagePickerPopup_Closed">
                    <Border Background="#FFF6E8"
                            BorderBrush="#211B15"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="4"
                            Margin="0,6,0,0">
                        <StackPanel>
                            <Button x:Name="FrenchLanguageButton"
                                    Tag="fr"
                                    Click="LanguageOptionButton_Click"
                                    Style="{StaticResource LanguageOptionButtonStyle}">
                                <Grid Width="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Width="24" Height="16" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Width="30" Height="20" BorderThickness="1" BorderBrush="#251F17" CornerRadius="2">
                                            <Grid ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Fill="#0055A4" />
                                                <Rectangle Grid.Column="1" Fill="#FFFFFF" />
                                                <Rectangle Grid.Column="2" Fill="#EF4135" />
                                            </Grid>
                                        </Border>
                                    </Viewbox>

                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#251F17"
                                               Text="FR" />
                                </Grid>
                            </Button>

                            <Button x:Name="EnglishLanguageButton"
                                    Tag="en"
                                    Click="LanguageOptionButton_Click"
                                    Style="{StaticResource LanguageOptionButtonStyle}">
                                <Grid Width="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Width="24" Height="16" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Width="30" Height="20" BorderThickness="1" BorderBrush="#251F17" CornerRadius="2" Background="#012169">
                                            <Grid ClipToBounds="True">
                                                <Line X1="0" Y1="0" X2="30" Y2="20" Stroke="#FFFFFF" StrokeThickness="5" />
                                                <Line X1="30" Y1="0" X2="0" Y2="20" Stroke="#FFFFFF" StrokeThickness="5" />
                                                <Line X1="0" Y1="0" X2="30" Y2="20" Stroke="#C8102E" StrokeThickness="2.4" />
                                                <Line X1="30" Y1="0" X2="0" Y2="20" Stroke="#C8102E" StrokeThickness="2.4" />
                                                <Rectangle Width="30" Height="8" Fill="#FFFFFF" VerticalAlignment="Center" />
                                                <Rectangle Width="8" Height="20" Fill="#FFFFFF" HorizontalAlignment="Center" />
                                                <Rectangle Width="30" Height="4" Fill="#C8102E" VerticalAlignment="Center" />
                                                <Rectangle Width="4" Height="20" Fill="#C8102E" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </Viewbox>

                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#251F17"
                                               Text="EN" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <Button x:Name="TrayButton"
                        Grid.Column="9"
                        Content="-"
                        Click="TrayButton_Click"
                        Style="{StaticResource ChromeButtonStyle}"
                        ToolTip="R&#xE9;duire dans la zone de notification" />

                <Ellipse x:Name="StateDot"
                         Grid.Column="9"
                         Grid.Row="1"
                         Width="16"
                         Height="16"
                         Margin="0,4,0,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Fill="#16794B" />
            </Grid>

            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="1"
                       Margin="0,10,0,12"
                       FontSize="14"
                       Foreground="#2F261D"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       Text="Pr&#xEA;t." />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PrimaryButton"
                        Grid.Column="0"
                        Click="PrimaryButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Button x:Name="SecondaryButton"
                        Grid.Column="2"
                        Click="SecondaryButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border x:Name="DropHintOverlay"
                    Grid.RowSpan="3"
                    Margin="2"
                    Padding="14"
                    Background="#F1F7EAD3"
                    BorderBrush="#1C3C31"
                    BorderThickness="2"
                    CornerRadius="12"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="DropHintIconTextBlock"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="#1C3C31"
                               HorizontalAlignment="Center"
                               Text="&#xE8E5;" />
                    <TextBlock x:Name="DropHintTextBlock"
                               Margin="0,10,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1C3C31"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Text="D&#xE9;posez un fichier audio ou vid&#xE9;o pour lancer la transcription." />
                </StackPanel>
            </Border>

            <primitives:Thumb Grid.RowSpan="3"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Cursor="SizeNWSE"
                              Style="{StaticResource ResizeThumbStyle}"
                              DragDelta="TopLeftResizeThumb_DragDelta" />

            <primitives:Thumb Grid.RowSpan="3"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Cursor="SizeNESW"
                              Style="{StaticResource ResizeThumbStyle}"
                              DragDelta="TopRightResizeThumb_DragDelta" />

            <primitives:Thumb Grid.RowSpan="3"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Cursor="SizeNESW"
                              Style="{StaticResource ResizeThumbStyle}"
                              DragDelta="BottomLeftResizeThumb_DragDelta" />

            <primitives:Thumb Grid.RowSpan="3"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Cursor="SizeNWSE"
                              Style="{StaticResource ResizeThumbStyle}"
                              DragDelta="BottomRightResizeThumb_DragDelta" />
        </Grid>
    </Border>
</Window>
